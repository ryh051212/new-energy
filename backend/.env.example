# 复制为 backend/.env.local，填写本机 PostgreSQL 配置；不要共享实际密码。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weidu_ev_team
DB_USER=postgres
DB_PASSWORD=

# 管理员登录；必须配置至少 8 位密码，留空时登录接口返回 503。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 开发与预览默认允许 localhost / 127.0.0.1 / [::1] 的 5173、5174、5175、4173 端口。
# 部署跨域前端时设置完整来源列表（配置后替换默认列表），不要填写 *。
# CORS_ALLOWED_ORIGINS=https://your-frontend.example

# 默认按 HTTPS 请求自动启用 Secure，HTTPS 反向代理部署可显式设 true。
# AUTH_COOKIE_SECURE=true
